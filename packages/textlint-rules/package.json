{
  "name": "@prosesmasher/textlint-rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "validate": "npm run build && npm run lint && g3ts validate --path . --rules-only"
  },
  "exports": {
    ".": "./dist/index.js",
    "./families/orthography/em-dashes": "./dist/families/orthography/em-dashes.js"
  },
  "dependencies": {
    "@textlint/types": "15.6.1",
    "sentence-splitter": "5.0.1",
    "textlint": "15.6.1",
    "textlint-rule-helper": "2.5.0",
    "textlint-util-to-string": "3.3.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3"
  }
}
